"use strict";
var spider = document.querySelector(".spider");
var wall = document.querySelector(".wall");
document.addEventListener("click", function(e) {
    var wallRect = wall.getBoundingClientRect();
    var wallInsideLeft = wallRect.left + wall.clientLeft;
    var wallInsideTop = wallRect.top + wall.clientTop;
    var spiderWidth = spider.offsetWidth;
    var spiderHeight = spider.offsetHeight;
    var clickLeft = e.clientX - wallInsideLeft - spiderWidth / 2;
    var clickTop = e.clientY - wallInsideTop - spiderHeight / 2;
    clickLeft = Math.max(0, Math.min(clickLeft, wall.clientWidth - spiderWidth));
    clickTop = Math.max(0, Math.min(clickTop, wall.clientHeight - spiderHeight));
    spider.style.left = "".concat(clickLeft, "px");
    spider.style.top = "".concat(clickTop, "px");
});

